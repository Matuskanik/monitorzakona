# Copy this file to .env and fill in your values.
# Stripe (v7) – get keys from Stripe Dashboard → Developers → API keys
# Secret key should start with sk_live_ or sk_test_
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
# Base URL of your app (no trailing slash) – used for Stripe redirects
APP_BASE_URL=https://monitorzakona.sk
# Optional: limit chat messages per law per month for paid users (default 200)
# CHAT_MESSAGES_PER_LAW_PER_MONTH=200
