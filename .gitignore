# Composer
/vendor/
composer.phar

# Database files (allow sentinel.db for deployment)
*.sqlite
*.sqlite3
public/data/*.db
# Note: data/sentinel.db is tracked for cloud deployment

# Allow JSON data files (generated by workflow)
# Files in public/data/ are served by Cloudflare Pages
!public/data/laws/
!public/data/index.json

# Storage and logs
/storage/logs/
/storage/snapshots/
/storage/*/attachments/
/logs/
*.log
# Note: storage/*/combined.txt and source_detail.html are tracked for cloud deployment

# Environment files
.env
.env.local
.env.*.local

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db# PHP
*.cache
.phpunit.result.cache# Temporary files
*.tmp
*.temp
*.bak
*.backup